/* ==========================================================================
   Base & Root Variables
   ========================================================================== */
:root {
  --font-heading: 'Playfair Display', Georgia, serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  
  /* Light Theme Palette */
  --bg-primary: #ffffff;
  --bg-alt: #f8fafc;
  --bg-card: #ffffff;
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --border-color: #e2e8f0;
  --accent-color: #1e3a8a; /* Deep Navy */
  --accent-hover: #1e40af;
  --accent-light: #eff6ff;
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

.dark-theme {
  /* Dark Theme Palette */
  --bg-primary: #0f172a;
  --bg-alt: #1e293b;
  --bg-card: #1e293b;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --border-color: #334155;
  --accent-color: #3b82f6; /* Lighter Blue */
  --accent-hover: #60a5fa;
  --accent-light: #1e3a8a;
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* ==========================================================================
   Typography & Layout Container
   ========================================================================== */
h1, h2, h3 {
  font-family: var(--font-heading);
  color: var(--text-primary);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 5rem 2rem;
}

.bg-alt {
  background-color: var(--bg-alt);
}

.section-title {
  font-size: 2.25rem;
  text-align: center;
  margin-bottom: 2.5rem;
}

/* ==========================================================================
   Navigation Header
   ========================================================================== */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 2rem;
  background-color: var(--bg-primary);
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 100;
  transition: background-color 0.3s ease;
}

.logo {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--accent-color);
}

.navbar nav ul {
  display: flex;
  list-style: none;
  gap: 2rem;
}

.navbar nav a {
  text-decoration: none;
  color: var(--text-secondary);
  font-weight: 600;
  transition: color 0.2s ease;
}

.navbar nav a:hover {
  color: var(--accent-color);
}

/* Buttons */
.btn-primary, .btn-secondary {
  padding: 0.6rem 1.25rem;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: all 0.2s ease;
}

.btn-primary {
  background-color: var(--accent-color);
  color: #ffffff;
  border: none;
}

.btn-primary:hover {
  background-color: var(--accent-hover);
}

.btn-secondary {
  background-color: transparent;
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.btn-secondary:hover {
  background-color: var(--bg-alt);
  border-color: var(--accent-color);
}

/* ==========================================================================
   Hero Section
   ========================================================================== */
.hero {
  padding: 8rem 2rem;
  text-align: center;
  background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg-primary) 100%);
  border-bottom: 1px solid var(--border-color);
}

.hero-content {
  max-width: 800px;
  margin: 0 auto;
}

.hero h1 {
  font-size: 3rem;
  margin-bottom: 1.25rem;
  line-height: 1.2;
}

.hero p {
  font-size: 1.25rem;
  color: var(--text-secondary);
  margin-bottom: 2rem;
}

.hero-buttons {
  display: flex;
  justify-content: center;
  gap: 1rem;
}

/* ==========================================================================
   Grid & Cards (About Section)
   ========================================================================== */
.grid-3 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.card {
  background-color: var(--bg-card);
  padding: 2rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow);
  transition: transform 0.2s ease;
}

.card:hover {
  transform: translateY(-4px);
}

.card h3 {
  font-size: 1.5rem;
  margin-bottom: 0.75rem;
  color: var(--accent-color);
}

.card p {
  color: var(--text-secondary);
}

/* ==========================================================================
   Interactive Policy Tabs
   ========================================================================== */
.tab-buttons {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.tab-btn {
  padding: 0.75rem 1.25rem;
  border: 1px solid var(--border-color);
  background-color: var(--bg-primary);
  color: var(--text-secondary);
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tab-btn.active, .tab-btn:hover {
  background-color: var(--accent-color);
  color: #ffffff;
  border-color: var(--accent-color);
}

.tab-content {
  display: none;
  background-color: var(--bg-card);
  padding: 2.5rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow);
  max-width: 800px;
  margin: 0 auto;
}

.tab-content.active {
  display: block;
  animation: fadeIn 0.3s ease;
}

.tab-content h3 {
  margin-bottom: 1rem;
  font-size: 1.75rem;
}

.tab-content p {
  margin-bottom: 0.75rem;
  color: var(--text-secondary);
}

/* ==========================================================================
   Voter Match Quiz
   ========================================================================== */
.quiz-box {
  max-width: 650px;
  margin: 0 auto;
  background-color: var(--bg-card);
  padding: 2.5rem;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow);
  text-align: center;
}

#quiz-question {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 1.5rem;
}

.quiz-options {
  display: flex;
  justify-content: center;
  gap: 1rem;
}

.quiz-options button {
  padding: 0.75rem 1.5rem;
  border-radius: 6px;
  border: 1px solid var(--accent-color);
  background-color: var(--accent-light);
  color: var(--text-primary);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.quiz-options button:hover {
  background-color: var(--accent-color);
  color: #ffffff;
}

#quiz-result {
  margin-top: 1.5rem;
  padding: 1rem;
  border-radius: 6px;
  font-weight: 600;
}

#quiz-result.match {
  background-color: #dcfce7;
  color: #166534;
}

#quiz-result.mismatch {
  background-color: #fee2e2;
  color: #991b1b;
}

/* Dark theme overrides for quiz results */
.dark-theme #quiz-result.match {
  background-color: #14532d;
  color: #f0fdf4;
}

.dark-theme #quiz-result.mismatch {
  background-color: #7f1d1d;
  color: #fef2f2;
}

/* ==========================================================================
   Modal Dialog
   ========================================================================== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 1;
  transition: opacity 0.3s ease;
}

.modal.hidden {
  display: none;
  opacity: 0;
}

.modal-content {
  background-color: var(--bg-card);
  padding: 2.5rem;
  border-radius: 8px;
  max-width: 550px;
  width: 90%;
  position: relative;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
  border: 1px solid var(--border-color);
}

.close {
  position: absolute;
  top: 1rem;
  right: 1.5rem;
  font-size: 1.75rem;
  cursor: pointer;
  color: var(--text-secondary);
}

blockquote {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-style: italic;
  margin: 1.5rem 0 1rem 0;
  padding-left: 1rem;
  border-left: 4px solid var(--accent-color);
  color: var(--text-primary);
}

/* ==========================================================================
   Footer & Helpers
   ========================================================================== */
footer {
  text-align: center;
  padding: 2rem;
  border-top: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.hidden {
  display: none !important;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Responsive Styles */
@media (max-width: 768px) {
  .navbar {
    flex-direction: column;
    gap: 1rem;
  }

  .hero h1 {
    font-size: 2.25rem;
  }

  .hero-buttons {
    flex-direction: column;
  }
}
